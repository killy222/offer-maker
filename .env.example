POSTGRES_DB=offer_creator
POSTGRES_USER=offer_creator
POSTGRES_PASSWORD=offer_creator
# Email (local dev: console backend; production: Gmail SMTP — use App Password, not account password)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=you@gmail.com
USE_S3_STORAGE=1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=offer-creator-media
AWS_S3_ENDPOINT_URL=http://minio:9000
# Origin the browser uses for <img src> / media URLs (not the Docker-internal minio hostname).
AWS_S3_PUBLIC_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
